{
  "name": "xalians",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "coverage:creatures": "node scripts/creatureCoverage.js",
    "check:creature-coverage": "node scripts/creatureCoverage.js --check",
    "simulate:creatures": "node apps/web/scripts/runNode.cjs packages/rules/src/generator/devtools/simulateGenerator.ts",
    "check:creature-simulation": "node apps/web/scripts/runNode.cjs packages/rules/src/generator/devtools/simulateGenerator.ts --check",
    "publish": "terraform apply -auto-approve"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "url": "^0.11.0"
  },
  "overrides": {
    "maplibre-gl": "1.15.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@typescript/typescript-linux-x64": "7.0.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
