# Plain (strict) peer-dependency resolution livelocks on this workspace's dependency
# graph: @aws-amplify/ui-react wants maplibre-gl@1.15.3 (via maplibre-gl-js-amplify)
# while @maplibre/maplibre-gl-geocoder wants maplibre-gl>=4.0.0, both from my-app's own
# tree, and npm's arborist oscillates between the two forever instead of converging or
# erroring (observed: 15+ minutes and a 250k-line debug log with no progress). Neither
# package is a direct Xalians dependency and neither map feature is used by the app, so
# forcing legacy (npm 6-era) peer resolution is safe here and lets npm install/ci finish
# in under a minute instead of hanging.
legacy-peer-deps=true
