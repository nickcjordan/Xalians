{
  "schemaVersion": 1,
  "species": "akinza",
  "decisions": {
    "source-abstract": {
      "status": "user-direction",
      "instruction": "Interpret the drawing; do not require literal source overlap or feature coordinates.",
      "words": "I don't think we should keep that rule in place because my images are always going to be an abstraction of what I actually want",
      "source": "Nick, this chat, 2026-09-27"
    },
    "ears-eyes": {
      "status": "user-direction",
      "instruction": "Ear edges are shaggy hair; eyes should be large and distinctive rather than literal squiggles.",
      "words": "the \"ragged edge ears\" are supposed to just be shaggy hair, not jagged edges. Regarding the eyes, the squiggle eyes that are there are more of an abstraction. So I just want the eyes to be something big and unique looking more than explicitly wanting you to have the jagged look. but sure lets see what you produce from these",
      "source": "Nick, this chat, 2026-09-27"
    },
    "style": {
      "status": "user-direction",
      "instruction": "Carry forward first-round style; run-0008 is a working identity reference.",
      "words": "Your first image generation, I liked much better than your second round",
      "source": "Nick, this chat, 2026-09-27"
    },
    "tail-root": {
      "status": "user-direction",
      "instruction": "One rear midline tail root at the base of spine.",
      "words": "yes The tail should be coming from the base of the spine, like every real animal's tail does",
      "source": "Nick, this chat, 2026-09-27"
    },
    "tail-fork-pelvis": {
      "status": "user-direction",
      "instruction": "One substantial common trunk blending continuously into three plumes; restrained rear pelvis. Run-0007 accepted as direction.",
      "words": "Think through it a little bit more. Your design is showing one base, but then there's two pieces that sort of branch out from mid-air behind the tail. It needs to have the three pieces of the tail form together more cleanly, like the base of a tree trunk does with its branches, rather than just having two more tails spawn out of the one tail that connects to the body. I also want you to tone down the butt form a tad because it's a little too sexual",
      "followUpWords": "yeah thats better, proceed",
      "source": "Nick, this chat, 2026-09-27"
    },
    "modeling-pose": {
      "status": "proposal",
      "instruction": "Separate pose with arms down and clear of torso, feet modestly apart.",
      "approval": null
    },
    "tail-depth": {
      "status": "proposal",
      "instruction": "Shallow front-back plume separation, shared trunk extending slightly rearward before turning left. Probe dimensions are arbitrary and require review.",
      "approval": null
    }
  },
