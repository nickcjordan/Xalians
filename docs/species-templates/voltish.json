{
  "schemaVersion": "4.0.0",
  "key": "voltish",
  "name": "Voltish",
  "nameOrigin": "Built from volt, the measure associated with electricity, with a softened ending that turns it into a creature name.",
  "element": "electric",
  "homePlanet": "zolton",
  "generatorPlanets": [
    "zolton"
  ],
  "lore": {
    "description": "With bones and claws made from a tough, conductive metal alloy, this daunting creature can store electrical energy from its surroundings and release the shock into enemies.",
    "appearance": [
      "Tall long-limbed biped, crouched low",
      "Shaggy fur coat",
      "Bones and claws of conductive metal alloy",
      "Narrow head with a long muzzle",
      "Upright pointed ears",
      "Broad clawed hands",
      "Large bushy tail"
    ],
    "origin": "One of the expendable workforce the Zolton Generator sent onto the lightning fields. No record says what work it was made for.",
    "habitat": "The deep canyons and metallic peaks of Zolton, where ground-borne lightning surges over the crust. It keeps clear of the black lightning dead zones.",
    "feeding": "It feeds on electrical charge from its surroundings and on nothing else.",
    "behavior": "It stores the charge it gathers in its alloy bones and releases the shock into enemies through its claws.",
    "company": "It keeps to itself."
  },
