{
  "schemaVersion": "4.0.0",
  "key": "thirstaserp",
  "name": "Thirstaserp",
  "nameOrigin": "A fusion of thirst and serpent, naming its snake-like body and the venom that drains a victim's water.",
  "element": "sand",
  "homePlanet": "endessa",
  "generatorPlanets": [
    "endessa"
  ],
  "lore": {
    "description": "A large, cobra-like creature that hides beneath the sand, Thirstaserps emit a subsonic vibration from the rattles on their tails that can lure and mesmerize opponents long enough for them to draw near and attack with a unique venom that drains the victim’s water when bitten, causing them to suffer and die from extreme dehydration.",
    "appearance": [
      "Large cobra-like serpent",
      "Scaled",
      "Viper's wedge head with long curved fangs",
      "Wide hood behind the head",
      "Tail ending in a rattle shaped like a lotus flower"
    ],
    "origin": "One of the desert forms the Syndicate's stolen prototype Generator produced on Endessa. No record says what it was made for.",
    "habitat": "Buried beneath the rolling dunes of Endessa.",
    "feeding": "It bites with a venom that drains the victim's water and leaves it to die of dehydration.",
    "behavior": "It hides beneath the sand and emits a subsonic vibration from the rattle on its tail that lures and mesmerizes opponents long enough for it to draw near and strike. It spreads its hood and shows its fangs before it does.",
    "company": "It hunts alone."
  },
